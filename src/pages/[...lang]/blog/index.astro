---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { defaultLang, languages, useTranslations, getLocalizedPath, type Lang } from '../../../i18n/ui';

const { lang: langParam } = Astro.params;
const lang = (langParam && langParam in languages ? langParam : defaultLang) as Lang;
const t = useTranslations(lang);

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'en' } },
  ];
}

const allPosts = await getCollection("blog");
const posts = allPosts.filter((post) => post.id.startsWith(`${lang ?? defaultLang}/`));
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={t("blog.title")}
  description={t("blog.desc")}
>
  <main class="px-5 text-white sm:px-8">
    <section class="mx-auto w-full max-w-7xl pb-24 pt-16 sm:pb-32 sm:pt-24">
      <header class="grid gap-8 border-b border-white/10 pb-10 sm:pb-14 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="mb-4 text-xs uppercase tracking-[0.18em] text-[#e8ff9c]">
            SparksLyse / Blog
          </p>
          <h1 class="max-w-3xl font-sans text-4xl font-normal leading-tight sm:text-5xl">
            {t("blog.title")}
          </h1>
          <p class="mt-5 max-w-2xl text-sm leading-7 text-white/55 sm:text-base">
            {t("blog.desc")}
          </p>
        </div>
        <p class="text-sm text-white/45 lg:pb-2">
          <span class="text-2xl text-white">{posts.length}</span>
          <span class="ml-2">{posts.length === 1 ? t("blog.published") : t("blog.publisheds")}</span>
        </p>
      </header>

      {
        posts.length > 0 ? (
          <ol class="divide-y divide-white/10" aria-label="Articles du blog">
            {posts.map((post, index) => (
              <li>
                <a
                  href={`${import.meta.env.BASE_URL}${lang}/blog/${post.id.replace(`${lang ?? defaultLang}/`, "")}/`}
                  class="group grid gap-4 py-7 transition-colors hover:bg-white/2.5 sm:gap-6 sm:py-9 md:grid-cols-[5rem_1fr_auto] md:items-start md:px-5"
                >
                  <span class="pt-1 font-mono text-xs text-white/35">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="min-w-0">
                    <h2 class="max-w-3xl text-xl font-medium leading-snug text-white transition-colors group-hover:text-[#e8ff9c] sm:text-2xl">
                      {post.data.title}
                    </h2>
                    <p class="mt-3 max-w-2xl text-sm leading-6 text-white/55">
                      {post.data.description}
                    </p>
                  </div>
                  <div class="flex items-center justify-between gap-4 md:justify-end md:pt-1">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="text-xs text-white/45 sm:text-sm"
                    >
                      {post.data.pubDate.toLocaleDateString(lang, {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                      })}
                    </time>
                    <span
                      aria-hidden="true"
                      class="text-lg text-[#e8ff9c] transition-transform group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="border-b border-white/10 py-10 text-sm text-white/55">
            Les premiers articles arrivent bientôt.
          </p>
        )
      }
    </section>
  </main>
</Layout>
